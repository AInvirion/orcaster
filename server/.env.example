# =============================================================================
# server/.env.example — template and documentation of the server variables
# =============================================================================
# Source of truth: server/orcaster_server/config.py (Settings class). pydantic-settings
# reads server/.env from the process WorkingDirectory (see orcaster.service).
#
# Local dev usage:   cp server/.env.example server/.env  and adjust what you need.
# In production (VPS) this file is NOT used: the .env is generated from the heredoc
# in setup-scripts/debian13/03-app-install.sh. If you add a variable here and it
# must persist in prod, add it to that heredoc too (otherwise a full
# re-provisioning reverts it to the code default).
#
# Convention: variables with a reasonable default are COMMENTED OUT, showing
# that default — uncomment them only to override. Required ones are active
# with a placeholder.
# =============================================================================

# --- Core -------------------------------------------------------------------

# REQUIRED. Async Postgres DSN (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/orcaster

# REQUIRED. Path to the Ed25519 private key that signs the lease tokens.
# Generate it with `make keygen server`.
ED25519_PRIVATE_KEY_PATH=/opt/orcaster/server/server-ed25519.key

# uvicorn bind interface and port. In prod it binds to loopback (Caddy acts as
# the TLS reverse proxy in front).
#BIND_HOST=0.0.0.0
#BIND_PORT=8000

# Default claim timeout for a task (seconds) if the task does not specify its own.
#DEFAULT_CLAIM_TIMEOUT_SECONDS=3600

# --- Task secrets -----------------------------------------------------------
# OPTIONAL. File with the Fernet keys that encrypt the workspace task secrets:
# one key per line, the first is the primary (it encrypts new values) and all of
# them decrypt; empty lines and lines starting with `#` are ignored. Generate a
# key: `cd server && uv run orcaster-task-secrets-keys generate`.
# - Unset or empty (default): the server starts with a WARNING, secret management
#   (API, dashboard, orcaster CLI) answers 503 when setting a secret; deleting still
#   works and the poll delivers no secrets; tasks take their values from each
#   worker's environment, except those that declare a name with a stored secret:
#   those stay queued until the file is configured and the server is restarted.
# - Set but unreadable, without keys, or with an invalid key: the server does NOT
#   start (the error names the path and, if applicable, the line; never the key).
# The path expands environment variables. With systemd LoadCredentialEncrypted=
# use `$CREDENTIALS_DIRECTORY` WITHOUT braces: this file replaces `${VAR}` with
# its value when read, and with an empty string if it is not defined.
# On a host managed by the installer (setup-scripts/debian13) this file is
# regenerated on every run of 03-app-install.sh: the path is declared in
# setup.env (with single quotes if it uses $CREDENTIALS_DIRECTORY), not here. If
# this file already has it (with or without `export`, with or without spaces
# around `=`) and setup.env does not declare it, or declares it with another
# value, the run stops without modifying this file: regenerating it without the
# path would leave tasks with stored secrets undelivered, and with another path
# the server would load a different key file on its next restart. With the same
# value in both files it continues.
# Rotation: new key as the first line (keeping the old ones), restart,
# `orcaster-task-secrets-keys rotate`, remove the old key, restart. The server
# only re-reads the file when a poll is about to reject a delivery because it
# cannot be decrypted; setting a secret does not re-read it, so this order still
# applies. With `rotate --keys-file` (systemd credential) see the user manual,
# "Rotate the key": `--confirm-server-key-id` is taken from the server startup
# log, not from the script output.
#TASK_SECRETS_KEYS_PATH=/opt/orcaster/secrets/task-secrets-keys
#TASK_SECRETS_KEYS_PATH=$CREDENTIALS_DIRECTORY/task-secrets-keys

# --- Plugins -----------------------------------------------------------------
# Ordered, comma-separated list of entry point names of the `orcaster.plugins`
# group. The listed ones take precedence over the other installed plugins, in the
# order written. A name that is not installed stops startup. Empty = only the
# installed plugins and the built-in providers.
#ORCASTER_PLUGINS=

# --- WebAuthn / passkeys (dashboard) ----------------------------------------
# rp_id = domain without scheme or port. In local dev the defaults (localhost)
# already work; in prod the heredoc derives them from the real domain.
#WEBAUTHN_RP_ID=localhost
#WEBAUTHN_RP_NAME=Orcaster
# Full origin of the dashboard: `scheme://host[:port]`, nothing more. It is
# validated at startup: a path, a query, a fragment, credentials or a scheme
# other than http/https make startup fail, naming the value; uppercase letters,
# the scheme's default port (`:443`, `:80`) and the trailing slash are corrected
# automatically. A browser sends the serialized origin in `Origin`, and it is
# compared for exact equality: `https://host:443` matches none.
#WEBAUTHN_ORIGIN=http://localhost:8000
# Session cookie over HTTPS only. In prod: true. In local dev (http): false.
#SESSION_COOKIE_SECURE=false
# Per-client (IP) limit for POST /auth/login/{begin,complete} and
# /auth/accept/{token}/register/{begin,complete}: in-memory token bucket, per
# uvicorn process (with N processes the effective cap is up to N times higher).
# The begin and complete endpoints use separate buckets with these same values.
# Past the limit: 429 with Retry-After.
# 0 in AUTH_BEGIN_RATE_PER_MINUTE disables it. The IP is the one uvicorn resolves
# from X-Forwarded-For only for the peers in FORWARDED_ALLOW_IPS (127.0.0.1).
#AUTH_BEGIN_RATE_PER_MINUTE=30
#AUTH_BEGIN_RATE_BURST=10
# Coarse level: bucket shared per network (IPv4 /24, IPv6 /48) so that rotating
# addresses does not evade the per-client limit. 0 disables it. It does not
# prevent a /24 (about 1000 begin requests in ~180 s with these values) from
# filling the pending-challenge cap (1000) and evicting other users' challenges.
#AUTH_BEGIN_GROUP_RATE_PER_MINUTE=300
#AUTH_BEGIN_GROUP_BURST=100
# true opens /openapi.json, /docs and /redoc without auth. Local development only.
#API_DOCS_PUBLIC=false

# --- Housekeeping -----------------------------------------------------------

# After this time without a heartbeat, a worker is marked offline and its lease expires.
#WORKER_HEARTBEAT_TIMEOUT_SECONDS=120
# Retention of the commands table before purging (days).
#COMMANDS_RETENTION_DAYS=7
# Interval between passes of the housekeeping loop (seconds).
#HOUSEKEEPING_INTERVAL_SECONDS=30
# Master switch for housekeeping.
#HOUSEKEEPING_ENABLED=true
# Startup grace window: housekeeping neither expires leases nor marks workers
# offline during this period, to give workers time to poll again after a
# restart. Default = lease (120) + one poll of margin.
#STARTUP_GRACE_SECONDS=150

# --- Migrations -------------------------------------------------------------
# Runs `alembic upgrade head` at startup. Disable it if you prefer to migrate as
# an explicit pipeline step.
#MIGRATE_ON_STARTUP=true

# --- Dashboard SSE ----------------------------------------------------------
# Real-time push via Server-Sent Events + Postgres LISTEN/NOTIFY. Default OFF:
# the infrastructure starts inert until the flag is enabled.
#SSE_ENABLED=false
# Stream keepalive (`: ping`) to avoid the ~100s Cloudflare cutoff (524).
#SSE_HEARTBEAT_INTERVAL_SECONDS=30
# Output coalescing: at most one SSE notification per execution every N ms.
#SSE_OUTPUT_COALESCE_MS=250

# --- Artifacts produced by the task -----------------------------------------
# Bytes on the filesystem, metadata in Postgres. The default lives OUTSIDE
# /opt/<repo> to survive the deploy's `rsync --delete`. Point it at a dedicated
# volume via ARTIFACTS_ROOT if you want.
#ARTIFACTS_ROOT=/var/lib/orcaster-artifacts

# Per-upload limits. Exceeding any of them -> 413 on the upload endpoint.
#   ARTIFACT_MAX_FILE_BYTES   size of ONE individual file.        default 50 MiB
#   ARTIFACT_MAX_TOTAL_BYTES  sum of files of ONE execution.      default 200 MiB
#   ARTIFACT_MAX_COUNT        number of files of ONE execution.   default 500
# NOTE: the Debian installer (setup-scripts/debian13) writes 200 MiB (209715200)
# for ARTIFACT_MAX_FILE_BYTES. If you set it equal to the total per execution, a
# single file of that size consumes the whole execution quota.
#ARTIFACT_MAX_FILE_BYTES=52428800
#ARTIFACT_MAX_TOTAL_BYTES=209715200
#ARTIFACT_MAX_COUNT=500

# Disk protection.
#   ARTIFACT_WORKSPACE_MAX_TOTAL_BYTES  AGGREGATE quota per workspace (sum of
#       all its artifacts). Different from the per-execution total. Exceeding it -> 507.
#       default 10 GiB.
#   ARTIFACT_DISK_MIN_FREE_BYTES        floor of PHYSICAL free space on the FS of
#       ARTIFACTS_ROOT (global safety net via statvfs). Dropping below it ->
#       507 / poll paused. default 2 GiB.
#ARTIFACT_WORKSPACE_MAX_TOTAL_BYTES=10737418240
#ARTIFACT_DISK_MIN_FREE_BYTES=2147483648
# TTL (seconds) of the in-process cache of free disk space. The poll checks the
# floor on every request from every worker and statvfs is a blocking syscall;
# while the TTL is valid there is no syscall and a concurrent burst produces at
# most one measurement (single-flight). 0 disables the cache (it always measures).
# Cost: storage_paused="disk" can lag by up to one TTL.
#ARTIFACT_DISK_FREE_CACHE_TTL_S=5.0
# How many housekeeping passes between reconciliations of the artifact usage
# counter. 10 ~ 5 min with the default 30s interval.
#ARTIFACT_USAGE_RECONCILE_PASSES=10

# --- Artifact indicator (dashboard pill) ------------------------------------
# Suffix of the artifacts counted by the indicator (e.g. .report.json). Empty
# (default) => off, the pill is not rendered.
#ARTIFACT_INDICATOR_SUFFIX=
# Path to the sync_status.json written by an external sync process.
# The app reads uploaded_total from it. Empty => the pill shows only `produced`.
# It must match the path where the external sync job writes its status.
#ARTIFACT_INDICATOR_SYNC_STATUS_PATH=
