# =============================================================================
# Provisioning configuration for the WORKER on Debian 13.
# Copy this file to /etc/orcaster/setup.env and fill in the values:
#     # the 'orcaster' group may not exist yet on a freshly created host
#     # (00-preflight.sh creates it and reconciles owner/mode afterwards); with
#     # the fallback without -o/-g the file stays root:root until that
#     # reconciliation.
#     install -d -m 0750 -o root -g orcaster /etc/orcaster 2>/dev/null \
#         || install -d -m 0750 /etc/orcaster
#     install -m 0640 -o root -g orcaster setup.env.example /etc/orcaster/setup.env 2>/dev/null \
#         || install -m 0640 setup.env.example /etc/orcaster/setup.env
#     $EDITOR /etc/orcaster/setup.env
#
# The LIVE host config goes in /etc/orcaster and NOT inside the checkout: the
# deployment replaces /opt/orcaster entirely on every release.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Public URL of the orchestrator (server). Remote workers connect through here
# (do NOT use host.containers.internal: that only works for a worker on the same
# host as the server). It must answer at ${ORCH_BASE_URL}/healthz.
#
# It MUST be a stable DNS name, NOT an IP. The value is stamped into each
# host's `/etc/orcaster/env` at enrollment, so pointing at an IP forces
# touching the whole fleet again if the server changes host or provider. With a
# DNS name, moving the server is repointing an A record: the workers are not
# re-enrolled or reconfigured.
ORCH_BASE_URL="https://orcaster.example.com"


# -----------------------------------------------------------------------------
# OPTIONAL — reasonable defaults; uncomment only if you need to change them
# -----------------------------------------------------------------------------

# Server Ed25519 public key (REQUIRED at runtime). Paste the complete PEM block
# here between quotes (multiline allowed). If you leave it empty, place the
# file by hand at /etc/orcaster/server-ed25519.pub.
# Get it on the server host:
#     openssl pkey -in server/.dev-ed25519.pem -pubout
# Format example:
#SERVER_ED25519_PUBKEY="-----BEGIN PUBLIC KEY-----
#MCowBQYDK2VwAyEA................................................=
#-----END PUBLIC KEY-----"
SERVER_ED25519_PUBKEY=""

# Dedicated system user that runs the worker (rootless Podman).
#WORKER_USER="orcaster"
#WORKER_HOME="/home/orcaster"

# Installation root of the code on the VPS. The code is NOT cloned: it is pushed
# from the operator's machine with ops/release/push-release.sh, which replaces
# this directory entirely on every release and leaves a RELEASE file at the
# root with the installed version and commit.
#INSTALL_DIR="/opt/orcaster"

# Descriptive name of the worker in the dashboard. Empty => the server uses the
# worker_id (or the reported hostname) as the label.
#ORCH_WORKER_NAME=""

# Number of workers to bring up on this VPS (mass deployment / cloud-init).
# Default 1. Each worker gets its own /etc/orcaster/env.N and its own identity
# (worker_id/api_key); all share the same multi-use ORCH_ENROLLMENT_TOKEN.
#WORKER_COUNT=1

# Prefix of the name shown in the dashboard: workers end up as PREFIX-1,
# PREFIX-2, … Empty => uses the VPS hostname. Applies only to new slots
# (without env.N or with an empty ORCH_WORKER_NAME): run-fleet.sh keeps the name
# that env.N already carries, so changing the prefix does not rename existing
# workers. To rename, edit or empty ORCH_WORKER_NAME
# in env.N and rerun run-fleet.sh.
#WORKER_NAME_PREFIX=""

# Memory cap per worker container (podman --memory). Format: number +
# suffix b/k/m/g (mandatory), e.g. 28g. Empty (default) = no cap, the same
# opt-in as the Makefile. With a cap active, the worker reports to the
# orchestrator the cgroup memory (memory.max) instead of the host RAM.
# It is read by run-fleet.sh and also by a direct `make up client`: a manual
# rerun keeps the cap declared here without having to repeat it on the command line.
#WORKER_MEMORY=""

# HOST directories mounted read-only at the SAME path inside each worker
# container (`-v <dir>:<dir>:ro`). Space-separated list of absolute paths.
# Empty (default) = no extra mount and the same `podman run` as always.
# Use case: a private wheel in /opt/example-ro, which a task installs with
# `file:///opt/example-ro/<wheel>`; the path is resolved inside the container,
# so without this mount the wheel does not exist for the task.
# Rules (check-ro-mounts.sh validates them before touching any container):
# only characters [A-Za-z0-9._/-] (no spaces, ':' or ','), no '.' or '..',
# no trailing slash, neither '/' nor paths that the container already uses or
# system paths (/app, /var, /tmp, /etc, /usr, /home/orcaster, ...); each
# directory must exist, the orcaster user must be able to traverse it, and it
# must be readable by "other": the directory and its subdirectories o+rx, the
# files o+r (e.g. /opt/example-ro 0755 and the wheel 0644; `chmod -R o+rX
# /opt/example-ro`). Inside the container the worker is a host subuid, neither
# orcaster nor in its group: a 0750 or a 0640 is not enough for it.
# It is read by run-fleet.sh, install-release.sh and also by a direct
# `make up client`.
# A change is applied only when the container is RE-CREATED (`make up client`,
# run-fleet.sh or a deployment); `podman restart` or restarting the systemd unit
# starts the existing container with its old mounts.
#WORKER_RO_MOUNTS="/opt/example-ro"

# Extra env appended to EACH /etc/orcaster/env.N. Generic channel for runtime
# secrets that the TASKS need (not the worker itself), e.g. download tokens for
# external services. Accepts multiple KEY=VALUE lines:
#EXTRA_ENV="API_TOKEN=tok_xxx
#GITHUB_TOKEN=ghp_yyy"
# A task without task_env inherits the worker's WHOLE environment, EXTRA_ENV
# included, except under strict isolation: see ORCH_ENFORCE_ISOLATION below.
# EXTRA_ENV cannot declare ORCH_ISOLATION_REQUIRED_ENV (that list goes in
# ISOLATION_REQUIRED_ENV), and if it declares ORCH_ENFORCE_ISOLATION with a
# value different from the one below, the installer (load_env, used by
# run-fleet.sh and the setup scripts) aborts.

# -----------------------------------------------------------------------------
# TASK ENVIRONMENT ISOLATION — declarative channel,
# DIFFERENT from EXTRA_ENV: WORKER configuration. It is stamped in its own
# block, after EXTRA_ENV, in each /etc/orcaster/env(.N).
# -----------------------------------------------------------------------------

# Strict isolation: true or false (any other value aborts). With true, a task
# that does not declare task_env receives a clean environment; with false (legacy
# mode) it receives the worker's full environment, including
# ORCH_ENROLLMENT_TOKEN and ORCH_API_KEY.
# The default in the worker code is true: a line missing from env.N also runs
# strict. The installer always stamps an explicit value. If left commented, the
# stamped value is resolved like this:
#   - EXTRA_ENV declares it    => that line applies (it is never weakened).
#   - the previous env.N has it => its value is kept.
#   - env.N already exists without the line
#                              => ORCH_ENFORCE_ISOLATION=false is stamped,
#                                 explicitly, so the decision is visible.
#   - new installation         => ORCH_ENFORCE_ISOLATION=true.
# To move an existing host to strict mode: drain the tasks that do not declare
# task_env (queued or assigned to its workers), uncomment the line with true and
# rerun run-fleet.sh. A `podman restart` or restarting the systemd unit does NOT
# re-read the --env-file: the change requires recreating the container.
#ORCH_ENFORCE_ISOLATION=true

# Variables that require strict isolation: exact names (case-sensitive, never
# patterns), separated by commas or spaces; each one must match
# [A-Za-z_][A-Za-z0-9_]* (any other value aborts). It is stamped in each env.N
# as ORCH_ISOLATION_REQUIRED_ENV=<names joined by commas>. If any of
# those variables is present and non-empty in the worker's environment with
# strict isolation off, the worker refuses to start (ERROR with the
# name, never the value, and exit 1). The pre-swap gate of install-release.sh
# reads this same list for EXTRA_ENV, together with the ORCH_ENFORCE_ISOLATION
# of this file, and the one in each env.N for that file; a malformed
# list aborts the deployment before the swap. Meant for credentials that are
# passed through EXTRA_ENV and that no task without task_env must see. Additive:
# it adds to the worker's built-in list (empty) and nothing reduces it. Empty
# (default) = the guard requires nothing.
#ISOLATION_REQUIRED_ENV="EXAMPLE_PROTECTED_VAR"

# MULTI-USE enrollment token that run-fleet.sh stamps in each
# /etc/orcaster/env.N. Applies only to the fleet flow; in the manual flow the
# operator places the token per worker in /etc/orcaster/env.
#ORCH_ENROLLMENT_TOKEN=""

# -----------------------------------------------------------------------------
# WORKER DISK GATE — declarative channel, DIFFERENT
# from EXTRA_ENV: this is configuration of the WORKER itself (free disk floor,
# fail-open deadline), not runtime secrets of the TASKS. It is stamped in its
# own commented block of each /etc/orcaster/env(.N) and survives a rerun of the
# suite as long as these lines stay here. Literal names of the env vars that
# the worker reads (client/src/orcaster_worker/config.py): no mapping layer.
# -----------------------------------------------------------------------------

# Free disk floor below which the worker stops asking for new tasks.
# Number between 0.0 and 1.0. Empty (default) => the line is not stamped and the
# worker uses its own default: it inherits ORCH_ORCASTER_CACHE_MIN_FREE_FRACTION (the
# GC floor, 0.20 today), so the gate closes exactly where the GC already declares the
# pressure unrecoverable. An explicit value must be <= that GC floor (the
# worker validates it at startup and aborts otherwise; see config.py); a higher
# floor would leave it unable to claim anything, with nothing in the system
# able to reopen it.
# `0` disables the gate entirely (it never stops for disk).
# When to lower it: if the 20 % inherited from the GC is too conservative for the
# size of the worker's disk (on a large volume, 20 % free is many idle GB)
# and you prefer it to keep claiming tasks with less margin.
# When to disable it (`=0`): if the volume has permanent content outside
# `cache_root/tasks/` (e.g. a worker-wide `uv` cache, large downloaded blobs)
# that the GC cannot free and the gate would stay closed with no way out, or if
# you prefer tasks to fail with a visible "no space" error rather than a worker
# silently stopped.
#ORCH_ORCASTER_CACHE_CLAIM_MIN_FREE_FRACTION=""

# Deadline (seconds) that the disk gate may spend stopping claims before
# fail-open: once it expires, the worker asks for tasks again even if the disk is still
# below the floor, so that tasks fail with the real cause (full disk) instead of
# leaving the fleet silently idle forever. It counts only stopped time
# (paused while the worker runs a task or flushes cache) and
# is reset if the disk recovers; it does not survive a container restart.
# Empty (default) => the line is not stamped; the worker's default is 1800
# (30 min). `0` disables the fail-open (the gate can stay closed forever if the
# disk is not freed).
#ORCH_ORCASTER_CACHE_CLAIM_GATE_MAX_SECONDS=""

# Step 2/2 of the fleet deployment: how long to wait (seconds) for ALL the
# workers to enroll against the orchestrator before aborting, and how often to
# retry the check. The deployment is only declared COMPLETE with the fleet
# visible in the dashboard.
#ENROLL_WAIT=120
#ENROLL_POLL=5
