# =============================================================================
# orcaster-worker — environment variables (.env)
# =============================================================================
# Copy this file to `.env` inside `client/`:
#     cp client/.env.example client/.env
# and fill in the values. The Makefile passes it to the container via
# `--env-file` (`make up client`); this project uses plain `podman run`, not
# compose.
#
# Variables without the `ORCH_` prefix in the code are mapped the same way when
# loaded inside the container (pydantic-settings with env_prefix="ORCH_").
# Full list: `client/src/orcaster_worker/config.py`.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Base URL of the orchestrator. Pick the format that matches your scenario:
#
# Scenario 1 — Remote server (real deployment):
#   ORCH_BASE_URL=https://orcaster.example.com
#
# Scenario 2 — Local server on macOS (Podman Machine):
#   The alias `host.containers.internal` points to your host from inside the
#   container.
#   ORCH_BASE_URL=http://host.containers.internal:8000
#
# Scenario 3 — Local server on native Linux:
#   Use `host.containers.internal`, as on macOS.
#   ORCH_BASE_URL=http://host.containers.internal:8000
ORCH_BASE_URL=http://host.containers.internal:8000


# Worker credential (api_key): NOT configured through env — the worker ignores
# it even if you define it here. The `api_key` is obtained automatically on the
# first start (self-registration with ORCH_ENROLLMENT_TOKEN, see below) and is
# persisted together with `worker_id` in /var/lib/orcaster/state.json (volume
# `orcaster-data`). On later starts the worker reuses that identity and does
# NOT register again. To force a new identity, purge the state
# (`make purge client`) and start again with a valid enrollment token.


# Enrollment token (multi-tenancy). **Required for self-registration**:
# on the first start (no state.json) the worker sends POST /v1/workers/register
# and the server REQUIRES an enrollment token scoped to a workspace. It can be
# single-use (max_uses=1) or multi-use (max_uses up to 1000). It is issued by a
# workspace member (out-of-band) and determines which workspace the worker is
# associated with.
#
# - Empty + no state.json -> the worker aborts at boot with an actionable
#   message (it does not send a register request that the server would reject
#   with 422).
# - Only used on the first start: after registering, the credentials are kept
#   in state.json and the token is not requested again (you can leave it empty
#   afterwards).
# - It is the ONLY startup credential configurable through env (there is no
#   ORCH_API_KEY path).
ORCH_ENROLLMENT_TOKEN=


# Ed25519 public key of the server. **MANDATORY**:
# every task delivered by the server is signed; without a configured pubkey the
# worker silently rejects every task and the server reclaims the lease when it
# expires (the worker "connects" but executes nothing).
#
# How to obtain it:
#   1. On the server host, derive the pubkey from the private PEM:
#        openssl pkey -in server/.dev-ed25519.pem -pubout -out server-ed25519.pub
#   2. Copy `server-ed25519.pub` to the worker host, e.g. to
#      `client/server-ed25519.pub` (the Makefile mounts it automatically
#      if it exists at that path; see `make up client`).
#   3. If you mount it at another path inside the container, adjust this
#      variable.
ORCH_ED25519_PUBLIC_KEY_PATH=/var/lib/orcaster/ed25519.pub


# Strict isolation of the tasks' environment. With true, a task that does not
# declare task_env gets a clean environment; this is the default in the code,
# so without this line the worker also runs strict. With false (legacy mode)
# it receives the worker's full environment, including ORCH_ENROLLMENT_TOKEN
# and ORCH_API_KEY, and the worker warns about it with a WARNING at startup. An
# explicit false is only appropriate while tasks without task_env remain in the
# queue. The change takes effect when the container is recreated
# (`make up client`): a `podman restart` does not re-read the --env-file.
ORCH_ENFORCE_ISOLATION=true

# Variables that require strict isolation: exact names (case-sensitive, never
# patterns), separated by commas or spaces, each [A-Za-z_][A-Za-z0-9_]*. If one
# of them is present and non-empty with ORCH_ENFORCE_ISOLATION=false, the
# worker refuses to start (ERROR with the name, never the value, and exit 1). A
# malformed name also stops it. Added to the worker's built-in list, which is
# empty. Empty = none.
#ORCH_ISOLATION_REQUIRED_ENV=EXAMPLE_PROTECTED_VAR


# -----------------------------------------------------------------------------
# OPTIONAL — reasonable defaults; uncomment only if you need to change them
# -----------------------------------------------------------------------------

# Descriptive worker name (shown in the dashboard). Useful for telling apart
# several workers on the same host. Default: empty (the server uses worker_id
# as the label).
#ORCH_WORKER_NAME=worker-laptop-1

# Worker capabilities: flat JSON name -> boolean|number that tasks request in
# `eligibility.capabilities` (e.g. ["gpu", "gpu_memory_mb>=5200"]). Sent on
# register and on every poll: changing it does not re-enroll, recreating the
# container is enough. No quotes around it (`podman --env-file` does not strip
# them). Empty or absent: declares nothing and the server keeps what it has
# stored. `{}` clears it.
#ORCH_CAPABILITIES={"gpu":true,"gpu_memory_mb":8192}


# Claim / lease.
#ORCH_LEASE_SECONDS=120              # TTL of the lease requested on each poll


# Unified polling loop (/poll). The server suggests
# `next_poll_after_seconds`; the client clamps it to this range.
#ORCH_POLL_MIN_SECONDS=1.0           # minimum cadence between polls (lower clamp)
#ORCH_POLL_MAX_SECONDS=30.0          # maximum cadence between polls (upper clamp + backoff)


# Cooperative cancellation: SIGTERM -> SIGKILL grace for the subprocess's
# process group.
#ORCH_CANCEL_GRACE_SECONDS=5.0


# Network reconnection (exponential backoff).
#ORCH_NETWORK_MAX_ATTEMPTS=5
#ORCH_NETWORK_BASE_DELAY_SECONDS=0.5
#ORCH_NETWORK_MAX_DELAY_SECONDS=30.0


# Push commands (`run_batch`): timeout window per command.
# Each command gets this full, independent window.
#ORCH_RUN_BATCH_PER_COMMAND_TIMEOUT_SECONDS=60


# Local state (change only if you remap the volume).
#ORCH_STATE_DIR=/var/lib/orcaster


# Task-scoped cache (resumable per-job scratch). The worker manages it by
# itself (age-based GC + disk pressure). The env vars carry a double prefix
# (env_prefix ORCH_ over the ORCASTER_CACHE_* aliases).
#
# Scratch cache root. Default: /var/cache/orcaster, the DEDICATED cache volume
# (orcaster-cache, mounted there by the Makefile; alongside the uv cache — see
# ORCH_ORCASTER_UV_CACHE_DIR below). It is NOT the /var/lib/orcaster data
# volume (that is where the worker's persistent state lives). The task-scoped
# scratch ends up in <cache_root>/tasks/<job_key>/ with hf/, pip/ and xdg/
# subdirs. Change this only if you remap the cache volume; without the volume
# mounted, the scratch would land in the container's ephemeral overlay and be
# lost when it is recreated.
#ORCH_ORCASTER_CACHE_ROOT=/var/cache/orcaster
#
# Delete on success. If true (default), the worker deletes the task's cache as
# soon as the run completes successfully; on failure/cancellation it keeps it
# for the retry. Setting false leaves the cache until the GC collects it.
#ORCH_ORCASTER_CACHE_DELETE_ON_SUCCESS=true
#
# uv cache (wheels). EMPTY (default) ⇒ PER-JOB uv cache in
# <cache_root>/tasks/<job_key>/uv, deleted together with the rest of the job's
# cache (on successful completion, or when the worker resets on switching
# jobs). An explicit value restores a WORKER-WIDE uv cache shared across all
# jobs (for example /var/cache/orcaster/uv): it avoids re-downloading
# the same wheels on every task. RECOMMENDED in production when jobs share
# Python dependencies. It lives outside tasks/, so the per-job reset does not
# touch it; only the operator's on-demand flush clears it.
#ORCH_ORCASTER_UV_CACHE_DIR=/var/cache/orcaster/uv
